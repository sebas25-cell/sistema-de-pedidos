{
  "openapi": "3.1.0",
  "info": {
    "title": "Servicio restaurantes",
    "description": "**Responsabilidad:** catálogo de restaurantes. Los clientes consultan los activos; el ADMIN los crea, edita, activa o desactiva (baja lógica, para conservar el historial de pedidos).\n\n**Datos propios:** base `db_restaurantes`, tabla `restaurantes`. El menú de cada restaurante vive en el servicio **menu**, que consulta aquí solo para validar que el restaurante exista.",
    "contact": {
      "name": "Sistema de Pedidos para Restaurantes - Montería"
    },
    "version": "4.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Monitoreo"
        ],
        "summary": "Estado del servicio",
        "description": "Devuelve 200 si el servicio y su base de datos responden, o 503 si algo falla. Lo usan los healthchecks de Docker y el panel de monitoreo.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": [
          "Monitoreo"
        ],
        "summary": "Métricas del servicio (solo ADMIN)",
        "description": "Peticiones, errores por clase, latencia media y p95, rutas más usadas, errores y avisos recientes.",
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/restaurantes": {
      "get": {
        "tags": [
          "Restaurantes"
        ],
        "summary": "Listar restaurantes activos",
        "description": "Público. Solo devuelve los restaurantes activos.",
        "operationId": "listar_restaurantes_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RestauranteOut"
                  },
                  "type": "array",
                  "title": "Response Listar Restaurantes Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Administración"
        ],
        "summary": "Crear un restaurante (ADMIN)",
        "operationId": "crear_restaurantes_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RestauranteIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestauranteOut"
                }
              }
            }
          },
          "401": {
            "description": "Sin sesión, token inválido o vencido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "El rol del usuario no tiene permiso para esta acción",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/restaurantes/{rid}": {
      "get": {
        "tags": [
          "Restaurantes"
        ],
        "summary": "Consultar un restaurante",
        "description": "Público. Devuelve el restaurante aunque esté inactivo (el servicio de pedidos lo usa para validar que esté recibiendo pedidos).",
        "operationId": "detalle_restaurantes__rid__get",
        "parameters": [
          {
            "name": "rid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Rid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestauranteOut"
                }
              }
            }
          },
          "404": {
            "description": "El recurso no existe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Administración"
        ],
        "summary": "Actualizar un restaurante (ADMIN)",
        "operationId": "actualizar_restaurantes__rid__put",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "rid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Rid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RestauranteIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestauranteOut"
                }
              }
            }
          },
          "401": {
            "description": "Sin sesión, token inválido o vencido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "El rol del usuario no tiene permiso para esta acción",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "El recurso no existe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Administración"
        ],
        "summary": "Desactivar un restaurante (ADMIN)",
        "description": "Baja lógica: deja de mostrarse y de recibir pedidos, pero se conserva su historial.",
        "operationId": "desactivar_restaurantes__rid__delete",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "rid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Rid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "401": {
            "description": "Sin sesión, token inválido o vencido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "El rol del usuario no tiene permiso para esta acción",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "El recurso no existe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/admin/restaurantes": {
      "get": {
        "tags": [
          "Administración"
        ],
        "summary": "Listar todos los restaurantes, incluidos los inactivos (ADMIN)",
        "operationId": "listar_todos_admin_restaurantes_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RestauranteOut"
                  },
                  "type": "array",
                  "title": "Response Listar Todos Admin Restaurantes Get"
                }
              }
            }
          },
          "401": {
            "description": "Sin sesión, token inválido o vencido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "El rol del usuario no tiene permiso para esta acción",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "Error",
        "description": "Formato de todas las respuestas de error del sistema."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RestauranteIn": {
        "properties": {
          "nombre": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Nombre"
          },
          "direccion": {
            "type": "string",
            "maxLength": 200,
            "title": "Direccion",
            "default": ""
          },
          "telefono": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 30
              },
              {
                "type": "null"
              }
            ],
            "title": "Telefono"
          },
          "activo": {
            "type": "boolean",
            "title": "Activo",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "nombre"
        ],
        "title": "RestauranteIn",
        "examples": [
          {
            "activo": true,
            "direccion": "Calle 27 #3-45, Montería",
            "nombre": "Burger del Sinú",
            "telefono": "3001234567"
          }
        ]
      },
      "RestauranteOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "nombre": {
            "type": "string",
            "title": "Nombre"
          },
          "direccion": {
            "type": "string",
            "title": "Direccion"
          },
          "telefono": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Telefono"
          },
          "activo": {
            "type": "integer",
            "title": "Activo"
          }
        },
        "type": "object",
        "required": [
          "id",
          "nombre",
          "direccion",
          "activo"
        ],
        "title": "RestauranteOut"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "description": "Token JWT que entrega `POST /usuarios/login`. Pégalo sin la palabra 'Bearer'.",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "Restaurantes",
      "description": "Consulta pública del catálogo."
    },
    {
      "name": "Administración",
      "description": "Gestión del catálogo (solo ADMIN)."
    },
    {
      "name": "Monitoreo",
      "description": "Salud y métricas del servicio."
    }
  ]
}