  "components": {
    "schemas": {
      "Disponibilidad": {
        "properties": {
          "disponible": {
            "type": "boolean",
            "title": "Disponible"
          }
        },
        "type": "object",
        "required": [
          "disponible"
        ],
        "title": "Disponibilidad"
      },
      "Error": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "Error",
        "description": "Formato de todas las respuestas de error del sistema."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Login": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Login",
        "examples": [
          {
            "email": "cliente@monteria.com",
            "password": "cliente123"
          }
        ]
      },
      "LoginOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "nombre": {
            "type": "string",
            "title": "Nombre"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "rol": {
            "type": "string",
            "title": "Rol"
          },
          "token": {
            "type": "string",
            "title": "Token",
            "description": "JWT; enviarlo como `Authorization: Bearer <token>`"
          }
        },
        "type": "object",
        "required": [
          "id",
          "nombre",
          "email",
          "rol",
          "token"
        ],
        "title": "LoginOut"
      },
      "NuevoUsuario": {
        "properties": {
          "nombre": {
            "type": "string",
            "maxLength": 100,
            "minLength": 2,
            "title": "Nombre"
          },
          "email": {
            "type": "string",
            "maxLength": 150,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "title": "Password",
            "description": "Mínimo 6 caracteres"
          },
          "rol": {
            "type": "string",
            "title": "Rol",
            "description": "CLIENTE, ADMIN o REPARTIDOR"
          }
        },
        "type": "object",
        "required": [
          "nombre",
          "email",
          "password",
          "rol"
        ],
        "title": "NuevoUsuario",
        "examples": [
          {
            "email": "pedro@monteria.com",
            "nombre": "Pedro Gómez",
            "password": "reparto1",
            "rol": "REPARTIDOR"
          }
        ]
      },
      "Registro": {
        "properties": {
          "nombre": {
            "type": "string",
            "maxLength": 100,
            "minLength": 2,
            "title": "Nombre"
          },
          "email": {
            "type": "string",
            "maxLength": 150,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "title": "Password",
            "description": "Mínimo 6 caracteres"
          }
        },
        "type": "object",
        "required": [
          "nombre",
          "email",
          "password"
        ],
        "title": "Registro",
        "examples": [
          {
            "email": "ana@correo.com",
            "nombre": "Ana Pérez",
            "password": "secreto1"
          }
        ]
      },
      "UsuarioOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "nombre": {
            "type": "string",
            "title": "Nombre"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "rol": {
            "type": "string",
            "title": "Rol"
          }
        },
        "type": "object",
        "required": [
          "id",
          "nombre",
          "email",
          "rol"
        ],
        "title": "UsuarioOut"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
