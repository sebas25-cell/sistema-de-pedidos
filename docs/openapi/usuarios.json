      "patch": {
        "tags": [
          "Repartidores"
        ],
        "summary": "Activar o desactivar mi disponibilidad",
        "description": "Solo los repartidores disponibles reciben asignación automática de pedidos y pueden aceptar pedidos de la bolsa.",
        "operationId": "cambiar_disponibilidad_repartidores_disponibilidad_patch",
        "requestBody": {
