{
  "openapi": "3.1.0",
  "info": {
    "title": "Servicio usuarios",
    "description": "**Responsabilidad:** identidad y acceso del sistema. Registra clientes, autentica a cualquier usuario y emite el **token JWT** que usan los demás servicios; administra el personal (admins y repartidores) y la **disponibilidad** de los repartidores.\n\n**Datos propios:** base `db_usuarios`, tabla `usuarios`. Ningún otro servicio accede a ella: los demás consultan este servicio por su API.\n\n**Roles:** `CLIENTE`, `REPARTIDOR`, `ADMIN`.",
    "contact": {
      "name": "Sistema de Pedidos para Restaurantes - Montería"
    },
    "version": "4.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Monitoreo"
        ],
        "summary": "Estado del servicio",
        "description": "Devuelve 200 si el servicio y su base de datos responden, o 503 si algo falla. Lo usan los healthchecks de Docker y el panel de monitoreo.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": [
          "Monitoreo"
        ],
        "summary": "Métricas del servicio (solo ADMIN)",
        "description": "Peticiones, errores por clase, latencia media y p95, rutas más usadas, errores y avisos recientes.",
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/registro": {
      "post": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Registrar un cliente",
        "description": "Registro público: siempre crea un usuario con rol `CLIENTE`. El personal lo crea un ADMIN con `POST /admin/usuarios`.",
        "operationId": "registro_registro_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Registro"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioOut"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos o regla de negocio no cumplida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflicto con el estado actual del recurso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/login": {
      "post": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Iniciar sesión",
        "description": "Valida correo y contraseña (bcrypt) y devuelve los datos del usuario con su **token JWT** (vigencia 12 h). Tras 5 intentos fallidos con el mismo correo se bloquea 15 minutos.",
        "operationId": "login_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginOut"
                }
              }
            }
          },
          "401": {
            "description": "Sin sesión, token inválido o vencido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Demasiados intentos, espera antes de reintentar",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/usuarios/{uid}": {
      "get": {
        "tags": [
          "Usuarios"
        ],
        "summary": "Consultar un usuario",
        "description": "Un CLIENTE o REPARTIDOR solo puede consultarse a sí mismo; un ADMIN, a cualquiera.",
        "operationId": "get_usuario_usuarios__uid__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "uid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Uid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioOut"
                }
              }
            }
          },
          "401": {
            "description": "Sin sesión, token inválido o vencido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "El rol del usuario no tiene permiso para esta acción",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "El recurso no existe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/repartidores": {
      "get": {
        "tags": [
