{
  "openapi": "3.1.0",
  "info": {
    "title": "Servicio pagos",
    "description": "**Responsabilidad:** registrar y controlar el pago de cada pedido. El **monto lo define el pedido** (se consulta al servicio de pedidos), nunca quien llama. TARJETA y NEQUI se aprueban de forma simulada y confirman el pedido; el EFECTIVO queda `PENDIENTE` y se cobra al entregar.\n\n**Datos propios:** base `db_pagos`, tabla `pagos`. Estados: `PENDIENTE`, `PAGADO`, `FALLIDO`, `REEMBOLSADO`.\n\nLas operaciones de creación, cobro y anulación son de **uso interno** (las invoca el servicio de pedidos).",
    "contact": {
      "name": "Sistema de Pedidos para Restaurantes - Montería"
    },
    "version": "4.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Monitoreo"
        ],
        "summary": "Estado del servicio",
        "description": "Devuelve 200 si el servicio y su base de datos responden, o 503 si algo falla. Lo usan los healthchecks de Docker y el panel de monitoreo.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": [
          "Monitoreo"
        ],
        "summary": "Métricas del servicio (solo ADMIN)",
        "description": "Peticiones, errores por clase, latencia media y p95, rutas más usadas, errores y avisos recientes.",
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/pagos": {
      "post": {
        "tags": [
          "Uso interno"
        ],
        "summary": "Registrar el pago de un pedido",
        "description": "Consulta el pedido por API, toma su total como monto y registra el pago. Es **idempotente**: si ya existe un pago vigente del pedido lo devuelve. Con TARJETA/NEQUI el pago queda `PAGADO` y pide al servicio de pedidos pasar a `CONFIRMADO`.",
        "operationId": "crear_pago_pagos_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PagoIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagoOut"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos o regla de negocio no cumplida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Sin sesión, token inválido o vencido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "El rol del usuario no tiene permiso para esta acción",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "El recurso no existe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflicto con el estado actual del recurso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Falló un servicio del que depende esta operación",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Un servicio del que depende esta operación no está disponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
