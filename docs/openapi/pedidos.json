          }
        },
        "type": "object",
        "required": [
          "producto_id",
          "cantidad"
        ],
        "title": "Item"
      },
      "PedidoCreado": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "total": {
            "type": "number",
            "title": "Total"
          },
          "estado": {
            "type": "string",
            "title": "Estado"
          }
        },
        "type": "object",
        "required": [
          "id",
          "total",
          "estado"
        ],
        "title": "PedidoCreado"
      },
      "PedidoIn": {
        "properties": {
          "cliente_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cliente Id",
            "description": "Solo lo usa un ADMIN; el cliente siempre es quien tiene la sesión"
          },
          "restaurante_id": {
            "type": "integer",
            "title": "Restaurante Id"
          },
          "direccion": {
            "type": "string",
            "maxLength": 255,
            "title": "Direccion"
          },
          "metodo_pago": {
            "type": "string",
            "title": "Metodo Pago",
            "description": "EFECTIVO, TARJETA o NEQUI",
            "default": "EFECTIVO"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "restaurante_id",
          "direccion",
          "items"
        ],
        "title": "PedidoIn",
        "examples": [
          {
            "direccion": "Calle 30 #5-20, Montería",
            "items": [
              {
                "cantidad": 2,
                "producto_id": 1
              },
              {
                "cantidad": 1,
                "producto_id": 6
              }
            ],
            "metodo_pago": "TARJETA",
            "restaurante_id": 1
          }
        ]
      },
      "ValidationError": {
        "properties": {
