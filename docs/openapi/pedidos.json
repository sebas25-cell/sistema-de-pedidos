  "components": {
    "schemas": {
      "CambioEstado": {
        "properties": {
          "estado": {
            "type": "string",
            "title": "Estado",
            "description": "Estado siguiente en la secuencia"
          }
        },
        "type": "object",
        "required": [
          "estado"
        ],
        "title": "CambioEstado",
        "examples": [
          {
            "estado": "CONFIRMADO"
          }
        ]
      },
      "Error": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "Error",
        "description": "Formato de todas las respuestas de error del sistema."
      },
      "EstadoOut": {
        "properties": {
          "id": {
            "type": "integer",
