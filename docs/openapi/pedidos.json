    "/pedidos/{pid}/estado": {
      "patch": {
        "tags": [
          "Cocina"
        ],
        "summary": "Avanzar el estado (ADMIN)",
        "description": "Solo permite pasar al estado **siguiente**. `EN_CAMINO` y `ENTREGADO` los mueve el servicio de domicilios cuando el repartidor avanza (403 si otro intenta). Al pasar a `LISTO` se crea el domicilio; al `ENTREGADO` se cobra el efectivo. Publica el evento `pedido.estado_cambiado`.",
        "operationId": "cambiar_estado_pedidos__pid__estado_patch",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "pid",
            "in": "path",
            "required": true,
            "schema": {
