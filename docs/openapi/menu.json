            "title": "Categoria"
          },
          "precio": {
            "type": "number",
            "exclusiveMaximum": 100000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Precio"
          },
          "stock": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Stock",
            "default": 0
          },
          "activo": {
            "type": "boolean",
            "title": "Activo",
            "default": true
          },
          "restaurante_id": {
            "type": "integer",
            "title": "Restaurante Id"
          }
        },
        "type": "object",
        "required": [
          "nombre",
          "precio",
          "restaurante_id"
        ],
        "title": "ProductoIn",
        "examples": [
          {
            "activo": true,
            "categoria": "Hamburguesas",
            "nombre": "Hamburguesa Clásica",
            "precio": 18000,
            "restaurante_id": 1,
            "stock": 40
          }
        ]
      },
      "ProductoOut": {
        "properties": {
          "id": {
            "type": "integer",
