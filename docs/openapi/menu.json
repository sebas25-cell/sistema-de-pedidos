    "/productos/{pid}/descontar": {
      "patch": {
        "tags": [
          "Uso interno"
        ],
        "summary": "Descontar stock (solo servicios internos)",
        "description": "Atómico: `UPDATE ... WHERE stock >= cantidad`; si no alcanza responde 409 sin tocar nada. Solo acepta llamadas firmadas con la clave interna (servicio de pedidos).",
        "operationId": "descontar_productos__pid__descontar_patch",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "pid",
            "in": "path",
            "required": true,
