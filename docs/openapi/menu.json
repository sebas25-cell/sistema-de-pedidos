{
  "openapi": "3.1.0",
  "info": {
    "title": "Servicio menu",
    "description": "**Responsabilidad:** productos de cada restaurante y su **inventario (stock)**. Expone el menú público, la gestión del ADMIN y las operaciones atómicas de stock que usa el servicio de pedidos.\n\n**Datos propios:** base `db_menu`, tabla `productos`. Para validar que un restaurante exista consulta el servicio **restaurantes** por su API (no comparte tablas).",
    "contact": {
      "name": "Sistema de Pedidos para Restaurantes - Montería"
    },
    "version": "4.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Monitoreo"
        ],
        "summary": "Estado del servicio",
        "description": "Devuelve 200 si el servicio y su base de datos responden, o 503 si algo falla. Lo usan los healthchecks de Docker y el panel de monitoreo.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": [
          "Monitoreo"
        ],
        "summary": "Métricas del servicio (solo ADMIN)",
        "description": "Peticiones, errores por clase, latencia media y p95, rutas más usadas, errores y avisos recientes.",
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
