  "components": {
    "schemas": {
      "Cantidad": {
        "properties": {
          "cantidad": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Cantidad"
          }
        },
        "type": "object",
        "required": [
          "cantidad"
        ],
        "title": "Cantidad"
      },
      "Error": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "Error",
        "description": "Formato de todas las respuestas de error del sistema."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
