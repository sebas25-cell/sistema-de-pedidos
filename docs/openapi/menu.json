          },
          "restaurante_id": {
            "type": "integer",
            "title": "Restaurante Id"
          },
          "nombre": {
            "type": "string",
            "title": "Nombre"
          },
          "categoria": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Categoria"
          },
          "precio": {
            "type": "number",
            "title": "Precio"
          },
          "stock": {
            "type": "integer",
            "title": "Stock"
          },
          "activo": {
            "type": "integer",
            "title": "Activo"
          }
        },
        "type": "object",
        "required": [
          "id",
          "restaurante_id",
          "nombre",
          "precio",
          "stock",
          "activo"
        ],
        "title": "ProductoOut"
      },
      "ProductoUpd": {
        "properties": {
          "nombre": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Nombre"
          },
          "categoria": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 50
              },
              {
                "type": "null"
              }
            ],
            "title": "Categoria"
          },
          "precio": {
            "type": "number",
